# The website talks only to the primary API. Provider fallbacks stay server-side.
NEXT_PUBLIC_ANIME_API_BASE_URL=https://anikoto-api-teramoto-danish.vercel.app

# Server-only caption fetch allowlist. This is not a secret.
ANIME_PROXY_BASE_URL=https://aonime-proxy.luffytv.workers.dev

# Public release APK. A normal Google Drive share URL is converted to a direct-download URL.
NEXT_PUBLIC_ANDROID_APK_URL="https://github.com/AS-Danish/luffytv-releases/releases/download/v1.0.12/luffytv-1.0.12-build12-arm64.apk"

# Enable temporarily while collecting playback diagnostics.
PLAYBACK_DIAGNOSTICS=false
PLAYBACK_MONITORING=true
NEXT_PUBLIC_PLAYBACK_MONITORING=true
NEXT_PUBLIC_PLAYBACK_DIAGNOSTICS=false
